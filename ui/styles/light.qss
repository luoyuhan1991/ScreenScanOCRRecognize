/* ===========================================================================
   light.qss — PySide6 浅色主题，与 mockup/light_ui_prototype.html 对齐

   设计原则
   --------
   1. 容器（sidebar / configPanel / logPanel / logHeader / logText / statusBar）
      显式画自己的背景色。
   2. 控件（QLabel / QSlider / QCheckBox 文字区 / configGroup 等）默认透明，
      由所在容器决定底色。
   3. 输入承载面（QLineEdit / QComboBox / QPushButton / sliderValue /
      checkbox indicator / 大按钮 / groupPill）保留独立白底/彩底 + 边框。
   4. QSS 注意点：`border: none` 会把 border-bottom 一并清掉，需要分边声明。
   5. 子类化的 QWidget 必须在 Python 端 `setAttribute(Qt.WA_StyledBackground, True)`
      并用 objectName 选择器（`#configPanel`），否则 background 不会真画出来。

   色板（与 mockup :root CSS 变量同步）
   ------------------------------------
   bg              #F1F5FA   主窗口兜底
   canvas          #FFFFFF   配置 / 日志 header / 输入框
   sidebar-bg      #F4F7FB
   primary         #2F6FEB / hover #2A60D1 / soft #DCE8FB
   danger          #E5484D / hover #CC3B40 / soft #F5B5B7
   border          #E3E8EF / strong #CBD5E1
   text            #1E293B / secondary #475569 / muted #94A3B8
   log-bg          #F7F9FC
   log-time        #6B7280 / log-info #16A34A / log-warn #E0A82E
   ============================================================================ */


/* ============================== 全局 ============================== */

QMainWindow, QWidget {
    background-color: #F1F5FA;
    color: #1E293B;
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* 默认透明：QSS 把 QWidget 的 background 也应用到所有非容器子类，会在白色
   ConfigPanel / 白色 LogHeader 上盖一层 #F1F5FA 灰矩形。需要白盒的（sliderValue
   / 输入框 / 按钮 / sliderValue 等）已在下面显式 override。*/
QLabel, QFrame, QSlider, QCheckBox {
    background: transparent;
}


/* ============================== 标题栏分隔线 ============================== */

/* 原生 Windows 标题栏在浅色主题下为白，与白色工作区融合。在标题栏正下方
   画一条 1px 灰横线作为视觉分隔，颜色/粗细与 sidebar 右侧那条竖线一致。*/
QFrame#titleBarSeparator {
    background-color: #E3E8EF;
    border: none;
}


/* ============================== 容器背景 ============================== */

QWidget#sidebar {
    background-color: #F4F7FB;
    border-right: 1px solid #E3E8EF;
}
QWidget#configPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #E3E8EF;
}
QWidget#logPanel {
    background-color: #FFFFFF;
}
QFrame#logHeader {
    background-color: #FFFFFF;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1px solid #E3E8EF;
}
QPlainTextEdit#logText {
    background-color: #F7F9FC;
    border: none;
    padding: 12px 16px;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
    color: #1E293B;
}
QWidget#statusBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FAFBFD, stop:1 #F4F6FA);
    border-top: 1px solid #E3E8EF;
}


/* ============================== Sidebar nav-item ============================== */

QFrame#navItem {
    border-radius: 8px;
}
QFrame#navItem:hover {
    background: #EEF4FE;
}
QFrame#navItem[active="true"] {
    background: #2F6FEB;
}
QFrame#navItem QLabel {
    color: #475569;
    font-size: 11px;
}
QFrame#navItem[active="true"] QLabel {
    color: #FFFFFF;
    font-weight: 500;
}


/* ============================== Config 区组件 ============================== */

/* group title 文字（左侧蓝色色块由独立 QFrame#groupPill 渲染） */
QLabel#groupTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
}
QFrame#groupPill {
    background-color: #2F6FEB;
    border-radius: 2px;
    border: none;
}

/* config 区内的次级 label（"扫描间隔（秒）" "ROI 预设" 等） */
QWidget#configPanel QLabel {
    color: #475569;
    font-size: 12px;
}
/* 上一条会把 groupTitle 也覆盖，特例补回 */
QWidget#configPanel QLabel#groupTitle {
    color: #1E293B;
    font-size: 13px;
}


/* ============================== 输入框 / 下拉框 ============================== */

/* 输入框 / 下拉框（对齐 mockup .input / .select：高 32 = 22 内容 + 4*2 padding + 2 border，
   下拉再额外右内距 30px 给箭头让位）*/
QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 22px;
    color: #1E293B;
    font-size: 13px;
}
QComboBox {
    padding-right: 30px;
}
QLineEdit:focus, QComboBox:focus {
    border-color: #2F6FEB;
    outline: 2px solid #DCE8FB;
}
/* 只读 QLineEdit：mockup .input 始终白底，靠 monospace + 偏淡文字色作只读提示 */
QLineEdit:read-only {
    color: #475569;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    background: transparent;
}
/* mockup .select::after 是个 8x8 的 V 形（border 旋转得到），这里 SVG chevron 等效，
   尺寸压到 10x10 跟 mockup 视觉一致。色与 stroke 已在 svg 里写死 #94A3B8。*/
QComboBox::down-arrow {
    image: url({ICON_DIR}/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* 弹出列表容器（mockup .dropdown-menu）：1px 灰边 + 圆角 + 13px 字号。 */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E3E8EF;
    border-radius: 6px;
    outline: 0;
    font-size: 13px;
}
/* 弹出列表 item（mockup .dropdown-menu .item / .item:hover / .item.active）。 */
QComboBox QAbstractItemView::item {
    min-height: 20px;
    padding: 7px 12px;
    color: #1E293B;
    border: none;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #F4F6FA;
    color: #1E293B;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #E6EFFD;
    color: #2F6FEB;
    font-weight: 500;
}


/* ============================== 按钮 ============================== */

/* 通用 QPushButton：白底 + 灰边（"浏览…/编辑/保存当前"等小按钮） */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 14px;
    color: #1E293B;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
}
QPushButton:pressed {
    background-color: #F1F5FA;
}

/* LargeButton 主操作（自定义 QFrame）— mockup 主要按钮 4 状态规范：
   默认 / 悬停 / 按下（更深底，inset shadow）/ 禁用（整体 opacity 0.4，由代码层
   QGraphicsOpacityEffect 实现，非 QSS） */
QFrame#btnPrimary {
    background-color: #2F6FEB;
    border: 1px solid #2F6FEB;
    border-radius: 6px;
}
QFrame#btnPrimary:hover {
    background-color: #2A60D1;
    border-color: #2A60D1;
}
QFrame#btnPrimary[pressed="true"] {
    background-color: #1F50C5;
    border-color: #1F50C5;
}
/* disabled 时关闭 hover 反馈：Qt QSS 的 :hover 在 disabled QFrame 上仍会 match，
   叠加 setEnabled 用的 0.4 opacity 后颜色变化几乎看不见，但语义上 disabled 不应有 hover。
   这里用更高 specificity 的 :disabled:hover 把背景复原到默认色。 */
QFrame#btnPrimary:disabled:hover {
    background-color: #2F6FEB;
    border-color: #2F6FEB;
}
QFrame#btnDanger {
    background-color: #E5484D;
    border: 1px solid #E5484D;
    border-radius: 6px;
}
QFrame#btnDanger:hover {
    background-color: #CC3B40;
    border-color: #CC3B40;
}
QFrame#btnDanger[pressed="true"] {
    background-color: #B53236;
    border-color: #B53236;
}
QFrame#btnDanger:disabled:hover {
    background-color: #E5484D;
    border-color: #E5484D;
}
/* 按钮内文字必须用带父级 ID 的复合选择器（specificity 200+），否则会被
   `QWidget#configPanel QLabel { color: #475569 }`（102）压过去，导致白字
   被涂成暗灰，看起来跟没设一样。 */
QFrame#btnPrimary QLabel#lbBtnTitle,
QFrame#btnDanger  QLabel#lbBtnTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
}
QFrame#btnPrimary QLabel#lbBtnHint,
QFrame#btnDanger  QLabel#lbBtnHint {
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
}

/* slider 值小盒子（白底灰边，独立"输入承载面") */
QLabel#sliderValue {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    color: #1E293B;
    font-size: 12px;
}


/* ============================== Checkbox ============================== */

QCheckBox {
    spacing: 6px;
    color: #1E293B;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #2F6FEB;
}
QCheckBox::indicator:checked {
    background-color: #2F6FEB;
    border-color: #2F6FEB;
    image: url({ICON_DIR}/check.svg);
}


/* ============================== Slider ============================== */

QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #E3E8EF;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #2F6FEB;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #2F6FEB;
    width: 16px;
    height: 16px;
    margin: -8px 0;
    border-radius: 10px;
}
QSlider::handle:horizontal:hover {
    background: #DCE8FB;
}


/* ============================== Log panel 局部 ============================== */

QLabel#logTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
}

/* 清空日志按钮：比通用 QPushButton 更轻、透明底（衬白色 logHeader） */
QPushButton#logClear {
    background: transparent;
    border: 1px solid #E3E8EF;
    border-radius: 6px;
    padding: 0 10px;
    color: #475569;
    font-size: 12px;
    height: 26px;
    min-height: 0;
}
QPushButton#logClear:hover {
    background-color: #E2E8F0;
    border-color: #CBD5E1;
}

/* 日志区滚动条：默认 Win 滚动条灰带 + 箭头按钮和浅色面板割裂感太强，
   做成细长透明 track + 圆角灰 handle，hover 时加深。 */
QPlainTextEdit#logText QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
    border: none;
}
QPlainTextEdit#logText QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 24px;
}
QPlainTextEdit#logText QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QPlainTextEdit#logText QScrollBar::add-line:vertical,
QPlainTextEdit#logText QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
    border: none;
}
QPlainTextEdit#logText QScrollBar::add-page:vertical,
QPlainTextEdit#logText QScrollBar::sub-page:vertical {
    background: transparent;
}
QPlainTextEdit#logText QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
    border: none;
}
QPlainTextEdit#logText QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 24px;
}
QPlainTextEdit#logText QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QPlainTextEdit#logText QScrollBar::add-line:horizontal,
QPlainTextEdit#logText QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
    border: none;
}
QPlainTextEdit#logText QScrollBar::add-page:horizontal,
QPlainTextEdit#logText QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ============================== Settings page ============================== */

/* 卡片列只占左半（settings_page.py 内 hbox 1:1 切分），右半留白。底色用主
   背景 #F1F5FA 而非白色：右半才不会像一片空着的白板；左半卡片自带白底 + 灰
   边，依然清晰可辨。中线本身不画 — 卡片右边界天然停在水平正中。*/
QWidget#settingsPage {
    background-color: #F1F5FA;
}
QWidget#settingsContent {
    background-color: #F1F5FA;
}
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QFrame#settingsCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E8EF;
    border-radius: 8px;
}
QLabel#settingsCardTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
}

/* row 容器：with_separator 的版本顶部 1px 灰线（mockup `.settings-row + .settings-row`）*/
QFrame#settingsRow, QFrame#settingsRowSep, QFrame#settingsHintRow {
    background: transparent;
    border: none;
}
QFrame#settingsRowSep {
    border-top: 1px solid #E3E8EF;
}
QLabel#settingsRowLabel {
    color: #1E293B;
    font-size: 13px;
}
QLabel#settingsHint {
    color: #94A3B8;
    font-size: 11px;
}

/* hotkey display：mockup .kbd 白底灰边等宽小标签 + 铅笔编辑按钮 */
QLabel#kbd {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 2px 8px;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
    color: #1E293B;
}
QPushButton#hotkeyEdit {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}
QPushButton#hotkeyEdit:hover {
    background-color: #E2E8F0;
    border-radius: 4px;
}

/* 重置按钮：mockup .reset-btn 白底 + 红边 + 红字 */
QPushButton#resetBtn {
    background-color: #FFFFFF;
    border: 1px solid #E5484D;
    border-radius: 6px;
    padding: 6px 14px;
    color: #E5484D;
    min-height: 22px;
}
QPushButton#resetBtn:hover {
    background-color: #FCEBEB;
}


/* ============================== About page ============================== */

QWidget#aboutPage {
    background-color: #FFFFFF;
}
QFrame#aboutContent {
    background-color: #FFFFFF;
}

QFrame#aboutHero {
    background: transparent;
}
/* 大蓝底圆角图标卡（与 sidebar active 同色） */
QFrame#aboutHeroIcon {
    background-color: #2F6FEB;
    border-radius: 16px;
}
QLabel#aboutAppName {
    font-size: 20px;
    font-weight: 600;
    color: #1E293B;
}
QLabel#aboutVersion {
    font-size: 13px;
    color: #475569;
}
QLabel#aboutTagline {
    font-size: 12px;
    color: #94A3B8;
}

/* 仓库链接：蓝色文字（点击开浏览器） */
QLabel#aboutLink {
    color: #2F6FEB;
    text-decoration: underline;
}
QLabel#aboutLink:hover {
    color: #2A60D1;
}


/* ============================== Status bar 局部 ============================== */

QWidget#statusBar QLabel {
    color: #475569;
    font-size: 12px;
}
QLabel#statusValue {
    color: #1E293B;
    font-weight: 500;
}
QFrame#statusSep {
    color: #CBD5E1;
}
