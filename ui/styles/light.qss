/* ===========================================================================
   light.qss —— 浅色主题，色板与 mockup/light_ui_prototype.html :root 对齐
   --bg            #F1F5FA   主窗口背景
   --canvas        #FFFFFF   卡片/面板背景
   --sidebar-bg    #F4F7FB   侧栏背景
   --sidebar-active #E6EFFD
   --primary       #2F6FEB   品牌蓝
   --primary-hover #2A60D1
   --primary-soft  #DCE8FB
   --danger        #E5484D
   --danger-hover  #CC3B40
   --border        #E3E8EF
   --border-strong #CBD5E1
   --text          #1E293B
   --text-secondary #475569
   --text-muted    #94A3B8
   --log-bg        #F7F9FC
   --log-time      #6B7280
   --log-info      #16A34A
   ============================================================================ */

QMainWindow, QWidget {
    background-color: #F1F5FA;
    color: #1E293B;
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ----- Sidebar (自绘 QWidget) ----- */
QWidget#sidebar {
    background-color: #F4F7FB;
    border-right: 1px solid #E3E8EF;
}
QFrame#navItem {
    background: transparent;
    border-radius: 8px;
}
QFrame#navItem:hover {
    background: #EEF4FE;
}
QFrame#navItem[active="true"] {
    background: #2F6FEB;
}
QFrame#navItem QLabel#navItemText {
    color: #475569;
    font-size: 11px;
}
QFrame#navItem[active="true"] QLabel#navItemText {
    color: #FFFFFF;
    font-weight: 500;
}

/* ----- Scan page = white canvas ----- */
ScanPage {
    background-color: #FFFFFF;
}

/* ----- Config panel ----- */
ConfigPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #E3E8EF;
}

/* group 容器：扁平，不画边框/阴影；视觉分组靠 spacing + group-title 蓝条 */
QFrame#configGroup {
    background: transparent;
    border: none;
}

/* group title 用左侧 3px 蓝条 + 加粗文字（mockup 的 ::before 伪元素近似） */
QLabel#groupTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
    border-left: 3px solid #2F6FEB;
    padding: 0px 0px 0px 8px;
    margin-bottom: 4px;
}

/* ----- 普通 label（如「扫描间隔（秒）」「ROI 预设」） ----- */
ConfigPanel QLabel {
    color: #475569;
    font-size: 12px;
}
ConfigPanel QLabel#groupTitle {
    color: #1E293B;
    font-size: 13px;
}

/* ----- 输入框 / 下拉框 ----- */
QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 24px;
    color: #1E293B;
}
QLineEdit:focus, QComboBox:focus {
    border-color: #2F6FEB;
    outline: 2px solid #DCE8FB;
}
QLineEdit:read-only {
    background-color: #F7F9FC;
    color: #475569;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
}
/* drop-down 与 down-arrow 留 Qt 原生（自定义 border 拼三角 QSS 不支持 transform；
   如需精细化箭头，需嵌入 SVG 资源，留作后续优化） */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E3E8EF;
    border-radius: 6px;
    selection-background-color: #DCE8FB;
    selection-color: #1E293B;
    outline: 0;
}

/* ----- 按钮 ----- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 14px;
    color: #1E293B;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
}
QPushButton:pressed {
    background-color: #F1F5FA;
}
/* LargeButton（自定义 QFrame，两行内容） */
QFrame#btnPrimary {
    background-color: #2F6FEB;
    border: 1px solid #2F6FEB;
    border-radius: 6px;
}
QFrame#btnPrimary:hover {
    background-color: #2A60D1;
    border-color: #2A60D1;
}
QFrame#btnPrimary[disabled="true"] {
    background-color: #B5CDF4;
    border-color: #B5CDF4;
}
QFrame#btnDanger {
    background-color: #E5484D;
    border: 1px solid #E5484D;
    border-radius: 6px;
}
QFrame#btnDanger:hover {
    background-color: #CC3B40;
    border-color: #CC3B40;
}
QFrame#btnDanger[disabled="true"] {
    background-color: #F5B5B7;
    border-color: #F5B5B7;
}
QFrame#btnPrimary QLabel#lbBtnTitle,
QFrame#btnDanger QLabel#lbBtnTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
QFrame#btnPrimary QLabel#lbBtnHint,
QFrame#btnDanger QLabel#lbBtnHint {
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    background: transparent;
}
/* disabled 文字也变浅一点保持一致感 */
QFrame#btnPrimary[disabled="true"] QLabel,
QFrame#btnDanger[disabled="true"] QLabel {
    color: rgba(255, 255, 255, 0.95);
}

/* slider value 小盒子 */
QLabel#sliderValue {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    color: #1E293B;
    font-size: 12px;
}

/* ----- Checkbox ----- */
QCheckBox {
    spacing: 6px;
    color: #1E293B;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #2F6FEB;
}
QCheckBox::indicator:checked {
    background-color: #2F6FEB;
    border-color: #2F6FEB;
    /* Qt 没有 ::after content，对勾用图片替代；为保持简洁先用纯色填充表示选中。 */
}

/* ----- Slider ----- */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #E3E8EF;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #2F6FEB;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #2F6FEB;
    width: 16px;
    height: 16px;
    margin: -8px 0;
    border-radius: 10px;
}
QSlider::handle:horizontal:hover {
    background: #DCE8FB;
}

/* ----- Log panel ----- */
LogPanel {
    background-color: #FFFFFF;
}
/* 日志头部带底分隔线（mockup .log-header { border-bottom }）*/
QFrame#logHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E3E8EF;
    min-height: 40px;
    max-height: 40px;
}
QLabel#logTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
}
/* 清空日志按钮——比通用 QPushButton 更窄/更轻 */
QPushButton#logClear {
    height: 26px;
    padding: 0 10px;
    font-size: 12px;
    background: transparent;
    border: 1px solid #E3E8EF;
    border-radius: 6px;
    color: #475569;
    min-height: 0;
}
QPushButton#logClear:hover {
    background-color: #F1F5F9;
    border-color: #E3E8EF;
}
QPlainTextEdit#logText {
    background-color: #F7F9FC;
    border: none;
    border-radius: 0;
    padding: 12px 16px;
    font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 12px;
    color: #1E293B;
}

/* ----- Status bar ----- */
QWidget#statusBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FAFBFD, stop:1 #F4F6FA);
    border-top: 1px solid #E3E8EF;
}
QWidget#statusBar QLabel {
    color: #475569;
    font-size: 12px;
}
QFrame#statusSep {
    color: #CBD5E1;
}
/* 当前运行状态文字（运行中/已停止…）加粗，颜色由代码动态注入 */
QLabel#statusValue {
    font-weight: 500;
    color: #1E293B;
}
